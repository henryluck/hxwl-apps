# 天枢平台凭证（替换 TODO_ 后填入真实值）
TIANXU_APP_KEY=TODO_填你的appKey
TIANXU_APP_SECRET=TODO_填你的appSecret
# test | prod
TIANXU_ENV=test
SERVER_HOST=0.0.0.0
# 天枢 API 基础地址（可选覆盖；不填则用官方默认 test/prod 地址）
# TIANXU_BASE_URL_TEST=https://open-test.yingzhongshare.com
# TIANXU_BASE_URL_PROD=https://open-api.yingzhongshare.com
SERVER_PORT=8000
# AES 信封密钥/IV（各 16 字节）。必须与客户端 spec.json 的对应字段完全一致。
# ⚠️ 勿复用原工程值：轮换时客户端与 server 必须同步改，漏一处即全线解密失败。
AES_KEY=TODO_16字节密钥
AES_IV=TODO_16字节IV
ACCESS_TOKEN_REFRESH_LEAD_SEC=600
TIANXU_TIMEOUT_SEC=10
LOG_LEVEL=INFO

# prdId 由客户端透传（App 的 spec.json → integrations.edge.prdId 为唯一权威来源），
# 服务端不覆盖、也不做产品白名单 —— 一台 server **零配置**同时服务任意多个 App / 产品，
# 新增 App 无需改动本文件。缺失或为空的 prdId 会被本地拦截为 9004。

# 意见反馈 SQLite 数据库路径（首次启动自动建库建表）
FEEDBACK_DB_PATH=data/feedback.db

# API 文档开关：默认 false（屏蔽 /docs /redoc /openapi.json，不泄漏接口结构）；
# 仅本地开发需要看文档时临时改 true，切勿带到生产。
DOCS_ENABLED=false

# AI 对话（OpenAI 兼容上游，如 DeepSeek https://api.deepseek.com）：Key 只在服务端持有，绝不下发给客户端
SILICONFLOW_API_KEY=TODO_填你的LLMKey
SILICONFLOW_BASE_URL=https://api.deepseek.com
SILICONFLOW_MODEL=deepseek-flash
# 客户端可指定的模型白名单（逗号分隔；默认模型始终可用）
SILICONFLOW_ALLOWED_MODELS=deepseek-flash
# 单次响应 token 上限（控制上游成本）
SILICONFLOW_MAX_TOKENS=2048
# 思考模式开关（DeepSeek 格式 {"thinking":{"type":...}}）：
# false=disabled 直接出答案（首字节快，推荐）；true=enabled 先输出思考过程
SILICONFLOW_ENABLE_THINKING=false
# LLM 流式读超时（秒），独立于天枢超时
LLM_TIMEOUT_SEC=120
# AI 对话限流（每设备：deviceId 优先，IP 兜底；分钟+日双窗口，0=不限）
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=200
# 对话历史模式：full=全量历史发上游（多轮上下文）/ current_only=每次只发当前问题
# （保留 system 人设指令，丢弃历史 user/assistant；省 token、上下文隔离。非法值回落 full）
CHAT_HISTORY_MODE=full

# 和风天气（QWeather）：Ed25519 私钥只在服务端（keys/qweather-ed25519-private.pem，gitignored）；
# 四项缺任一 → /v2/gw/forecast/* 返回 9011 天气服务未配置（fail-closed 降级）
QWEATHER_KID=TODO_填和风控制台凭证kid
QWEATHER_PROJECT_ID=TODO_填和风项目ID
QWEATHER_API_HOST=TODO_填和风API主机名
QWEATHER_PRIVATE_KEY_PATH=keys/qweather-ed25519-private.pem
# 高程代理（/v2/gw/terrain/height）走 Open-Meteo 免费接口，无需凭证

# AccessToken 集中管理：本 server 作为消费方，从 provider 拉取 token（不再自己调天枢 refresh）。
# provider 是另一台 server（token 唯一刷新方），本 server 通过 GET {TOKEN_API_URL} 拉取，
# 请求头携带 X-API-Key: {TOKEN_API_KEY}。provider 返回 {success, code, data:{accessToken, expiresIn}}。
# 两项缺任一 → get_access_token 抛 CODE_NO_CREDENTIALS（9002）。
TOKEN_API_URL=https://qnsjgj.juliangshuke.com/api/accesstoken
TOKEN_API_KEY=
